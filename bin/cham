#!/usr/bin/env bash
set -euo pipefail
version='0.1.0-alpha.8'
cmd=${1:-help}
shift || true
script_dir=$(cd "$(dirname "$0")" && pwd)
if [[ -x /usr/lib/cham-linux/ai-system-report ]]; then
  ai_reporter=/usr/lib/cham-linux/ai-system-report
else
  ai_reporter="$script_dir/../ai/system-report.sh"
fi

pass() { printf 'PASS  %s\n' "$1"; }
warn() { printf 'WARN  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; }

doctor() {
  local bad=0
  printf 'Cham Linux Doctor %s\n' "$version"
  printf 'OS: '
  # shellcheck disable=SC1091
  . /etc/os-release
  printf '%s | Kernel: %s\n' "$PRETTY_NAME" "$(uname -r)"
  if dpkg --audit | grep -q .; then fail 'incomplete packages'; bad=1; else pass 'package database'; fi
  if apt-get -s check >/dev/null 2>&1; then pass 'APT dependency graph'; else fail 'APT dependency graph'; bad=1; fi
  if rg -q '^Suites:.*\bnoble-proposed\b' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null; then fail 'noble-proposed enabled'; bad=1; else pass 'stable Ubuntu pockets'; fi
  if rg -q 'kali.org|kali-rolling|archlinux' /etc/apt/sources.list /etc/apt/sources.list.d -g '*.list' -g '*.sources' 2>/dev/null; then fail 'foreign distribution repository on host'; bad=1; else pass 'no Kali/Arch host repository'; fi
  if systemctl is-active --quiet apparmor; then pass 'AppArmor active'; else fail 'AppArmor inactive'; bad=1; fi
  if systemctl is-active --quiet ufw; then pass 'firewall service active'; else warn 'firewall service inactive or unreadable'; fi
  if command -v nvidia-smi >/dev/null; then nvidia-smi --query-gpu=name,driver_version --format=csv,noheader; fi
  if command -v docker >/dev/null; then
    docker_context=$(docker context show 2>/dev/null || true)
    if [[ $docker_context == desktop-linux ]] && systemctl is-active --quiet docker; then
      warn 'Docker Desktop context selected while native Docker Engine is active'
      printf '  Use: docker context use default\n'
    elif [[ -n $docker_context ]]; then
      pass "Docker context: $docker_context"
    fi
  fi
  printf 'Sleep modes: '; cat /sys/power/mem_sleep 2>/dev/null || printf 'unavailable\n'
  if systemctl --failed --no-legend | grep -q .; then warn 'failed system services'; systemctl --failed --no-pager; fi
  printf '\nExternally bound TCP listeners:\n'
  ss -lntH | awk '$4 ~ /^0\.0\.0\.0:|^\[::\]:|^\*:/' || true
  return "$bad"
}

status() {
  printf 'Cham Linux %s\n' "$version"
  printf 'Host: %s | Kernel: %s\n' "$(hostname)" "$(uname -r)"
  printf 'APT pending: '; apt-get -s dist-upgrade 2>/dev/null | awk '/^[0-9]+ upgraded/ {print; found=1} END {if (!found) print "unavailable"}'
  if command -v snap >/dev/null; then printf 'Snap pending:\n'; snap refresh --list 2>&1 || true; fi
  if command -v flatpak >/dev/null; then printf 'Flatpak pending:\n'; flatpak remote-ls --updates 2>&1 || true; fi
  if command -v distrobox-list >/dev/null; then printf 'Distroboxes:\n'; distrobox-list 2>&1 || true; fi
  test -f /var/run/reboot-required && printf 'Restart: required\n' || printf 'Restart: not requested\n'
}

ai_status() {
  local bad=0
  printf 'Cham Linux AI status\n'
  if command -v nvidia-smi >/dev/null; then
    nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
  else
    warn 'NVIDIA GPU not detected'; bad=1
  fi
  if command -v ollama >/dev/null; then
    printf 'Ollama: '; ollama --version
    printf 'Local models:\n'; ollama list || true
    if ss -lntH | awk '$4 == "0.0.0.0:11434" || $4 == "[::]:11434" || $4 == "*:11434" { found=1 } END { exit !found }'; then
      warn 'Ollama API is exposed beyond localhost on port 11434'
      printf '  Restrict it to 127.0.0.1 unless you intentionally use remote clients.\n'
      bad=1
    else
      pass 'Ollama API is local-only'
    fi
  else
    warn 'Ollama is not installed'
  fi
  if command -v podman >/dev/null; then pass 'Podman available for isolated AI projects'; else warn 'Podman unavailable'; fi
  if command -v distrobox >/dev/null; then pass 'Distrobox available for isolated toolchains'; else warn 'Distrobox unavailable'; fi
  return "$bad"
}

ai_report() {
  "$ai_reporter"
}

ai_diagnose() {
  local model=${1:-}
  command -v ollama >/dev/null || { fail 'Ollama is not installed'; return 1; }
  command -v curl >/dev/null || { fail 'curl is not installed'; return 1; }
  command -v jq >/dev/null || { fail 'jq is not installed'; return 1; }
  ollama show "$model" >/dev/null 2>&1 || { fail "model not installed: $model"; return 1; }
  [[ -n $model ]] || { fail 'a model name is required'; return 1; }
  local available_kib swap_free_kib gpu_free_mib
  available_kib=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
  swap_free_kib=$(awk '/^SwapFree:/ { print $2 }' /proc/meminfo)
  gpu_free_mib=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -dc '0-9')
  if [[ ${available_kib:-0} -lt 6291456 || ${swap_free_kib:-0} -lt 6291456 || ${gpu_free_mib:-0} -lt 4096 ]]; then
    fail 'insufficient RAM, swap, or GPU headroom for a local diagnostic model'
    printf 'Run cham ai report, close memory-heavy applications, then retry.\n' >&2
    return 1
  fi
  local report payload response
  report=$(ai_report)
  payload=$(jq -n --arg model "$model" --arg evidence "$report" '{
    model: $model,
    stream: false,
    options: {temperature: 0},
    format: {
      type: "object",
      properties: {
        summary: {type: "string"},
        findings: {type: "array", items: {type: "string"}},
        safe_next_steps: {type: "array", items: {type: "string"}},
        escalation_needed: {type: "boolean"}
      },
      required: ["summary", "findings", "safe_next_steps", "escalation_needed"]
    },
    messages: [{
      role: "system",
      content: "You are a local Linux diagnostic assistant. Analyze only the supplied evidence. Do not invent facts. Never recommend automatically running destructive commands, changing kernel configuration, changing drivers, or exposing services. Suggest only read-only checks or clearly reversible next steps. Return JSON matching the requested schema."
    }, {
      role: "user",
      content: $evidence
    }]
  }')
  response=$(curl --fail --silent --show-error --max-time 180 \
    -H 'Content-Type: application/json' \
    -d "$payload" http://127.0.0.1:11434/api/chat)
  jq -r '.message.content | fromjson | "Summary: \(.summary)\n\nFindings:\n" + (.findings | map("- " + .) | join("\n")) + "\n\nSafe next steps:\n" + (.safe_next_steps | map("- " + .) | join("\n")) + "\n\nEscalation needed: \(.escalation_needed)"' <<<"$response"
}

update_check() {
  printf 'Refreshing APT metadata requires administrator authentication.\n'
  sudo apt-get update --error-on=any
  apt-get -s dist-upgrade
  if command -v snap >/dev/null; then snap refresh --list || true; fi
  if command -v flatpak >/dev/null; then flatpak remote-ls --updates || true; fi
  if command -v fwupdmgr >/dev/null; then fwupdmgr get-updates || true; fi
  echo 'Check only: no updates were installed.'
}

experience() {
  if [[ -x /usr/lib/cham-linux/experience ]]; then
    exec /usr/lib/cham-linux/experience "${1:-status}"
  fi
  echo 'Cham Experience is not installed. Update cham-linux-core first.' >&2
  return 1
}

release_preflight() {
  local bad=0
  git_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  [[ -n $git_root ]] || { fail 'run inside the Cham Linux repository'; return 1; }
  if git -C "$git_root" diff --quiet && git -C "$git_root" diff --cached --quiet; then pass 'clean Git worktree'; else fail 'uncommitted changes'; bad=1; fi
  if bash "$git_root/tests/static.sh"; then pass 'static checks'; else fail 'static checks'; bad=1; fi
  if dpkg --audit | grep -q .; then fail 'package database'; bad=1; else pass 'package database'; fi
  if systemctl --failed --no-legend | grep -q .; then fail 'failed services exist'; bad=1; else pass 'no failed services'; fi
  if [[ -f $git_root/reports/loq-latest.json ]]; then pass 'LOQ hardware report present'; else fail 'LOQ hardware report missing'; bad=1; fi
  if [[ -f $git_root/reports/restore-latest.json ]]; then pass 'restore report present'; else fail 'restore report missing'; bad=1; fi
  return "$bad"
}

case "$cmd" in
  doctor) doctor ;;
  status) status ;;
  update)
    [[ ${1:-} == --check ]] || { echo 'Only cham update --check is available in alpha.' >&2; exit 2; }
    update_check
    ;;
  release-preflight) release_preflight ;;
  ai)
    case ${1:-} in
      status) ai_status ;;
      report) ai_report ;;
      diagnose)
        shift || true
        [[ ${1:-} == --allow-heavy ]] || { echo 'Usage: cham ai diagnose --allow-heavy MODEL' >&2; exit 2; }
        shift
        ai_diagnose "${1:-}"
        ;;
      *) echo 'Usage: cham ai {status|report|diagnose --allow-heavy MODEL}' >&2; exit 2 ;;
    esac
    ;;
  experience) experience "${1:-status}" ;;
  version|--version|-V) echo "$version" ;;
  help|-h|--help)
    echo 'Usage: cham {doctor|status|experience {apply|status|reset}|ai {status|report|diagnose --allow-heavy MODEL}|update --check|release-preflight|version}'
    ;;
  *) echo "Unknown command: $cmd" >&2; exit 2 ;;
esac
